# Set these under Netlify > Site configuration > Environment variables.
# NEVER commit real secrets. Sandbox accounts are needed for test checkout.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_secret
# Merchant-set rate only, NOT a live FX rate. Example intentionally omitted.
# Enter a verified conversion rate you are willing to quote to customers.
PAYPAL_USD_PER_ZAR=

# Required for persistent orders: Supabase Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key
# Register public HTTPS webhook endpoint in PayPal, subscribe to PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNDOQO_ADMIN_API_KEY=your_random_private_admin_key_64_hex_characters
